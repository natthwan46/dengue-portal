datasource db {
  provider = "sqlite"
}

generator client {
  provider = "prisma-client-js"
}

model DengueReport {
  id          Int      @id @default(autoincrement())
  area        String
  riskLevel   String
  cases       Int      @default(0)
  description String?
  latitude    Float?
  longitude   Float?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}